<div class="modal-overlay">

    <div class="modal-box">

        <h2>
            <%= isEdit ? 'Edit Contact' : 'Add Contact' %>
        </h2>

        <form hx-post="<%= isEdit
                ? `/settings/contacts/${contact.id}`
                : `/settings/entities/${entityId}/contacts`
            %>" hx-target="#main-content" hx-swap="innerHTML" hx-on="
                    htmx:afterSwap:
                    if(event.detail.target.id === 'main-content'){
                        closeModal();
                    }">

            <!-- ============================= -->
            <!-- Contact Name -->
            <!-- ============================= -->

            <div class="form-group">

                <label>Name</label>

                <input type="text" name="contact_name" value="<%= contact.contact_name || '' %>" required>

            </div>

            <!-- ============================= -->
            <!-- Designation -->
            <!-- ============================= -->

            <div class="form-group">

                <label>Designation</label>

                <input type="text" name="designation" value="<%= contact.designation || '' %>">

            </div>

            <!-- ============================= -->
            <!-- Email -->
            <!-- ============================= -->

            <div class="form-group">

                <label>Email</label>

                <input type="email" name="email" value="<%= contact.email || '' %>">

            </div>

            <!-- ============================= -->
            <!-- Mobile -->
            <!-- ============================= -->

            <div class="form-group">

                <label>Mobile</label>

                <input type="text" name="mobile" value="<%= contact.mobile || '' %>">

            </div>

            <!-- ============================= -->
            <!-- Office Phone -->
            <!-- ============================= -->

            <div class="form-group">

                <label>Office Phone</label>

                <input type="text" name="phone" value="<%= contact.phone || '' %>">

            </div>

            <!-- ============================= -->
            <!-- Primary Contact -->
            <!-- ============================= -->

            <div class="checkbox-group">

                <input type="checkbox" name="is_primary" <%=contact.is_primary ? 'checked' : '' %>>

                <label>
                    Primary Contact
                </label>

            </div>

            <!-- ============================= -->
            <!-- Active -->
            <!-- ============================= -->

            <div class="checkbox-group">

                <input type="checkbox" name="is_active" <%=contact.is_active !==false ? 'checked' : '' %>>

                <label>
                    Active
                </label>

            </div>

            <!-- ============================= -->
            <!-- Remarks -->
            <!-- ============================= -->

            <div class="form-group form-full">

                <label>Remarks</label>

                <textarea name="remarks" rows="3"><%= contact.remarks || '' %></textarea>

            </div>

            <!-- ============================= -->
            <!-- Actions -->
            <!-- ============================= -->

            <div class="modal-actions">

                <button type="button" onclick="closeModal()">

                    Cancel

                </button>

                <button type="submit" id="saveBtn" disabled>

                    Save

                </button>

            </div>

        </form>

    </div>

</div>

<script>

    setTimeout(() => {

        const form =
            document.querySelector(
                '#modal form'
            );

        if (form) {

            enableSaveOnChange(
                form
            );

        }

    }, 0);

</script>
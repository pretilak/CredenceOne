<div class="modal-overlay">

    <div class="modal-box">

        <h2>
            <%= isEdit ? 'Edit User' : 'Add User' %>
        </h2>

        <form hx-post="<%= isEdit ? `/settings/users/${user.id}` : '/settings/users' %>" hx-target="#main-content"
            hx-swap="innerHTML" hx-on="
                htmx:beforeRequest:
                    disableSave(this);

                htmx:afterSwap:
                    if(event.detail.target.id === 'main-content'){
                        closeModal();
                    }
            ">

            <!-- ============================= -->
            <!-- Name -->
            <!-- ============================= -->

            <div class="form-group">

                <label>Name</label>

                <input type="text" name="name" value="<%= user.name || '' %>" required>

            </div>

            <!-- ============================= -->
            <!-- Email -->
            <!-- ============================= -->

            <div class="form-group">

                <label>Email</label>


                <input type="email" name="email" value="<%= user.email || '' %>" required
                    hx-post="/settings/users/validate-email" hx-trigger="input changed delay:500ms"
                    hx-target="#emailValidation" hx-swap="innerHTML" hx-include="[name='email'], [name='user_id']">

            </div>
            <div id="emailValidation" class="validation-message form-full">&nbsp;</div>

            <input type="hidden" name="user_id" value="<%= user.id || '' %>">

            <!-- ============================= -->
            <!-- Company -->
            <!-- ============================= -->

            <div class="form-group">

                <label>Company</label>


                <% if (isEdit) { %>

                    <input type="text" value="<%= companies.find(c => c.id == user.company_id)?.name || '' %>" readonly>
                    <input type="hidden" name="company_id" value="<%= user.company_id || '' %>">

                    <% } else { %>

                        <select name="company_id" required <%=companyId ? 'disabled' : '' %>>

                            <option value="">
                                Select Company
                            </option>

                            <% companies.forEach(company=> { %>

                                <option value="<%= company.id %>" <%=( companyId==company.id ||
                                    user.company_id==company.id ) ? 'selected' : '' %>>

                                    <%= company.name %>

                                </option>

                                <% }) %>

                        </select>
                        <% if (companyId) { %>

                            <input type="hidden" name="company_id" value="<%= companyId %>">

                        <% } %>

                    <% } %>

            </div>

            <input type="hidden" name="return_company_id" value="<%= companyId || '' %>">
            
            <!-- ============================= -->
            <!-- Role -->
            <!-- ============================= -->

            <div class="form-group">

                <label>Role</label>

                <select name="role_id" required>

                    <option value="">
                        Select Role
                    </option>

                    <% roles.forEach(r=> { %>

                        <option value="<%= r.id %>" <%=user.role_id==r.id ? 'selected' : '' %>>

                            <%= r.role_name %>

                        </option>

                        <% }) %>

                </select>

            </div>

            <% if (!isEdit) { %>

                <!-- ============================= -->
                <!-- Password -->
                <!-- ============================= -->

                <div class="form-group">

                    <label>Password</label>

                    <input type="password" id="password" name="password" required>

                </div>

                <!-- ============================= -->
                <!-- Confirm Password -->
                <!-- ============================= -->

                <div class="form-group">

                    <label>Confirm Password</label>

                    <input type="password" id="confirmPassword" name="confirm_password" required>

                </div>

                <div id="passwordError" class="form-error form-full">
                </div>

                <% } %>

                    <!-- ============================= -->
                    <!-- Active -->
                    <!-- ============================= -->

                    <div class="checkbox-group">

                        <input type="checkbox" name="is_active" <%=user.is_active !==false ? 'checked' : '' %>>

                        <label>
                            Active
                        </label>

                    </div>

                    <div id="formError" class="form-error form-full">
                    </div>

                    <!-- ============================= -->
                    <!-- Actions -->
                    <!-- ============================= -->

                    <div class="modal-actions">

                        <button type="button" onclick="closeModal()">

                            Cancel

                        </button>

                        <button type="submit" id="saveBtn" disabled>

                            Save

                        </button>

                    </div>

        </form>

    </div>

</div>

<script>

    function emailIsValid() {

        const emailValidation =
            document.getElementById(
                'emailValidation'
            );

        if (!emailValidation) {
            return true;
        }

        return !emailValidation.querySelector(
            '.validation-error'
        );
    }

    window.updateButton =
        enableSaveOnChange(
            document.querySelector(
                '.modal-box form'
            ),
            emailIsValid
        );
</script>

<script>

    (() => {

        function validatePasswords() {

            const password =
                document.getElementById('password');

            const confirmPassword =
                document.getElementById('confirmPassword');

            const error =
                document.getElementById('passwordError');

            const saveBtn =
                document.getElementById('saveBtn');

            if (
                !password ||
                !confirmPassword ||
                !error ||
                !saveBtn
            ) {
                return;
            }

            if (
                password.value.length === 0 &&
                confirmPassword.value.length === 0
            ) {

                error.innerText = '';
                error.style.visibility = 'hidden';

                saveBtn.disabled = true;

                return;
            }

            if (
                confirmPassword.value.length > 0 &&
                password.value !== confirmPassword.value
            ) {

                error.innerText =
                    'Passwords do not match';

                error.style.visibility =
                    'visible';

                saveBtn.disabled = true;

                return;
            }

            error.innerText = '';
            error.style.visibility = 'hidden';

            //saveBtn.disabled = false;
        }

        const password =
            document.getElementById('password');

        const confirmPassword =
            document.getElementById('confirmPassword');

        if (password) {
            password.addEventListener(
                'input',
                validatePasswords
            );
        }

        if (confirmPassword) {
            confirmPassword.addEventListener(
                'input',
                validatePasswords
            );
        }

    })();

</script>

<script>
    document.body.addEventListener(
        'htmx:responseError',
        function (evt) {

            const errorDiv =
                document.getElementById(
                    'formError'
                );

            if (errorDiv) {

                errorDiv.innerText =
                    evt.detail.xhr.responseText;

                errorDiv.style.visibility =
                    'visible';

            }

        }
    );

    function clearFormError() {

        const errorDiv =
            document.getElementById(
                'formError'
            );

        if (!errorDiv) {
            return;
        }

        errorDiv.innerText = '';

        errorDiv.style.visibility =
            'hidden';
    }

    document
        .querySelectorAll(
            '.modal-box input, .modal-box select'
        )
        .forEach(field => {

            field.addEventListener(
                'input',
                clearFormError
            );

            field.addEventListener(
                'change',
                clearFormError
            );

        });

</script>

<script>
    document.body.addEventListener(
        'htmx:afterSwap',
        function (evt) {

            if (
                evt.target.id ===
                'emailValidation'
            ) {

                const emailField =
                    document.querySelector(
                        '[name="email"]'
                    );

                if (emailField) {

                    emailField.dispatchEvent(
                        new Event(
                            'change',
                            { bubbles: true }
                        )
                    );

                }
            }
        }
    );</script>

<style>
    .form-error {
        min-height: 18px;
        visibility: hidden;
        color: #dc2626;
        font-size: 0.85rem;
        font-style: italic;
    }

    .form-full {
        grid-column: 1 / -1;
    }

    .validation-error {
        color: #dc2626;
        font-size: 0.85rem;
    }

    .validation-success {
        color: #16a34a;
        font-size: 0.85rem;
    }
</style>
<h1>Dashboard</h1>

<div class="dashboard-grid">
  <div class="tile">Cash: $10,000</div>
  <div class="tile">Receivables: $5,000</div>
  <div class="tile">Payables: $2,000</div>
</div>

<style>
  /* Dashboard style */
  .dashboard-grid {
    display: grid;

    /* auto responsive columns */
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));

    gap: 20px;
    margin-top: 20px;
  }

  .tile {
    background: #f5f5f5;
    border: 1px solid #ccc;
    border-radius: 10px;

    padding: 20px;
    min-height: 120px;

    display: flex;
    align-items: center;
    justify-content: center;

    font-weight: bold;
  }
</style>
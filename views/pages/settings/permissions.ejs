<div class="table-container">

    <table>

        <thead>

            <tr class="action-row">

                <th colspan="4">

                    <div class="action-row-content">

                        <span class="title">

                            Permissions

                        </span>

                        <span class="toolbar-actions">

                            <input
                                type="text"
                                id="tableFilter"
                                placeholder="Search roles...">

                        </span>

                    </div>

                </th>

            </tr>

            <tr class="header-row">

                <th class="sortable">
                    Role Name
                </th>

                <th class="sortable">
                    Role Code
                </th>

                <th class="sortable">
                    System
                </th>

                <th>
                    Action
                </th>

            </tr>

        </thead>

        <tbody>

            <% roles.forEach(role => { %>

                <tr
                    id="role-<%= role.id %>"
                    class="<%= updatedId == role.id ? 'updated-row' : '' %>">

                    <td>

                        <%= role.role_name %>

                    </td>

                    <td>

                        <%= role.role_code %>

                    </td>

                    <td>

                        <%= role.is_system
                            ? 'Yes'
                            : 'No' %>

                    </td>

                    <td>

                        <button
                            class="btn-secondary"
                            hx-get="/settings/roles/<%= role.id %>/permissions"
                            hx-target="#main-content"
                            hx-swap="innerHTML"
                            hx-push-url="true">

                            Permissions

                        </button>

                    </td>

                </tr>

            <% }) %>

        </tbody>

    </table>

</div>

<script>

    initTablePage();

    enableTableFilter(
        '#tableFilter',
        'tbody tr'
    );

    enableTableSorting(
        '.table-container table'
    );

</script>

    <style>
        /* ========================================= */
        /* Header Layout */
        /* ========================================= */

        .action-row-content {

            display: flex;

            justify-content: space-between;

            align-items: center;

            width: 100%;
        }

        .toolbar-actions {

            display: flex;

            align-items: center;

            gap: 10px;
        }

        .toolbar-actions input {

            width: 250px;

            padding: 8px 12px;

            border: 1px solid #cbd5e1;

            border-radius: 4px;

            font-size: 13px;
        }


        /* ========================================= */
        /* Page Title */
        /* ========================================= */

        .action-row-content .title {

            font-size: 16px;

            font-weight: 600;

            color: #1e293b;
        }


        /* ========================================= */
        /* Primary Button */
        /* ========================================= */

        .btn-primary {

            background-color: #007bff;

            color: #ffffff;

            border: none;

            padding: 6px 14px;

            border-radius: 4px;

            font-weight: 600;

            font-size: 13px;

            cursor: pointer;

            transition: background-color 0.15s ease-in-out;
        }

        .btn-primary:hover {

            background-color: #0056b3;
        }

        .btn-secondary {
            background-color: #f8fafc;
            color: #475569;
            border: 1px solid #cbd5e1;
            padding: 6px 14px;
            border-radius: 4px;
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.15s ease-in-out;
        }

        .btn-secondary:hover {
            background-color: #e2e8f0;
            color: #0f172a;
        }

        /* ========================================= */
        /* Table */
        /* ========================================= */

        table {

            width: 100%;

            border-collapse: separate;

            border-spacing: 0;

            font-family: sans-serif;

            table-layout: fixed;
        }

        table tbody tr {
            transition:
                background-color 0.15s ease;
        }

        table tbody tr:hover td {
            background-color:
                #b5d5f5;
        }

        /* ========================================= */
        /* Sticky Header */
        /* ========================================= */

        thead {

            position: sticky;

            top: 0;

            z-index: 2;
        }


        /* ========================================= */
        /* Action Row */
        /* ========================================= */

        .action-row th {

            background-color: #f1f1f1;

            padding: 10px;

            text-align: left;

            border-bottom: 1px solid #ccc;
        }


        /* ========================================= */
        /* Header Row */
        /* ========================================= */

        .header-row th {

            background-color: #333;

            color: white;

            padding: 12px;

            text-align: left;
        }


        /* ========================================= */
        /* Cells */
        /* ========================================= */

        td {

            padding: 12px;

            border-bottom: 1px solid #eee;

            overflow: hidden;

            text-overflow: ellipsis;

            white-space: nowrap;
        }


        /* ========================================= */
        /* Zebra */
        /* ========================================= */

        tr:nth-child(even) {

            background-color: #f9f9f9;
        }


        /* ========================================= */
        /* Name Column Wrap */
        /* ========================================= */

        td:first-child {

            white-space: normal;
        }


        /* ========================================= */
        /* Action Buttons */
        /* ========================================= */

        td:last-child {

            white-space: nowrap;
        }

        /* ========================================= */
        /* Toolbar */
        /* ========================================= */

        .toolbar {

            display: flex;

            justify-content: flex-end;

            align-items: center;

            padding: 10px;

            background-color: #f8fafc;

            border-bottom: 1px solid #e2e8f0;
        }


        /* ========================================= */
        /* Search Box */
        /* ========================================= */

        .toolbar input[type="text"] {

            width: 280px;

            padding: 8px 12px;

            border: 1px solid #cbd5e1;

            border-radius: 4px;

            font-size: 13px;

            background-color: white;

            transition:
                border-color 0.15s ease,
                box-shadow 0.15s ease;
        }


        .toolbar input[type="text"]:focus {

            outline: none;

            border-color: #007bff;

            box-shadow:
                0 0 0 3px rgba(0, 123, 255, 0.15);
        }


        .toolbar input[type="text"]::placeholder {

            color: #94a3b8;
        }

        /*=========================================*/
        /*============ Sorting ====================*/
        /*=========================================*/
        .sortable {

            cursor: pointer;

            user-select: none;

            position: relative;
        }

        .sortable:hover {

            background-color: #475569;
        }

        .sortable[data-sort="asc"]::after {

            content: " ▲";

            font-size: 10px;
        }

        .sortable[data-sort="desc"]::after {

            content: " ▼";

            font-size: 10px;
        }
    </style>
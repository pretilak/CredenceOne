<form
    id="userPermissionsForm"
    class="permissions-form"
    hx-post="/settings/users/<%= selectedUser.id %>/userPermissions"
    hx-target="#main-content"
    hx-swap="innerHTML">

    <div class="table-container permissions-container">

        <!-- ========================================= -->
        <!-- Header                                   -->
        <!-- ========================================= -->

        <div class="permissions-header">

            <div>

                <h2>

                    Permissions - <%= selectedUser.name %>

                </h2>

                <div class="role-code">

                    <%= selectedUser.email %><br>

                    Role:
                    <strong><%= selectedUser.role_name %></strong>

                </div>

            </div>

            <div class="header-actions">

                <button
                    type="button"
                    class="btn-secondary"
                    hx-get="/settings/users"
                    hx-target="#main-content"
                    hx-swap="innerHTML"
                    hx-push-url="true">

                    ← Back

                </button>

                <button
                    id="saveBtn"
                    type="submit"
                    class="btn-primary"
                    disabled>

                    Save

                </button>

            </div>

        </div>


        <!-- ========================================= -->
        <!-- Permission Cards                         -->
        <!-- ========================================= -->

        <div class="permissions-grid">

            <% Object.keys(groupedPermissions).forEach(moduleName => { %>

                <div class="permission-card">

                    <h3>

                        <%= moduleName %>

                    </h3>

                    <div class="permission-list">

                        <% groupedPermissions[moduleName].forEach(permission => { %>

                            <div class="permission-item">

                                <label>

                                    <input
                                        type="checkbox"
                                        name="permissions"
                                        value="<%= permission.id %>"
                                        <%= permission.assigned ? 'checked' : '' %>>

                                    <span class="permission-name">

                                        <%= permission.permission_name %>

                                    </span>

                                </label>

                            </div>

                        <% }) %>

                    </div>

                </div>

            <% }) %>

        </div>

    </div>

</form>

<script>

/*     const form =
        document.getElementById('userPermissionsForm');

    if (form) {

        enableSaveOnChange(form);

    } */

    (() => {

        const form =
            document.getElementById('userPermissionsForm');

        if (form) {

            enableSaveOnChange(form);

        }

    })();

</script>

<style>


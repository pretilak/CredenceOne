<form id="permissionsForm" class="permissions-form" hx-post="/settings/roles/<%= role.id %>/rolePermissions"
    hx-target="#main-content" hx-swap="innerHTML">

    <div class="table-container permissions-container">

        <!-- ========================================= -->
        <!-- Header -->
        <!-- ========================================= -->

        <div class="permissions-header">

            <div>

                <h2>
                    Permissions - <%= role.role_name %>
                </h2>

                <div class="role-code">
                    <%= role.role_code %>
                </div>

            </div>

            <div class="header-actions">

                <button type="button" class="btn-secondary" hx-get="/settings/roles" hx-target="#main-content"
                    hx-swap="innerHTML" hx-push-url="true">

                    ← Back

                </button>

                <button id="saveBtn" type="submit" class="btn-primary" disabled>

                    Save

                </button>
            </div>

        </div>


        <!-- ========================================= -->
        <!-- Permission Cards -->
        <!-- ========================================= -->

        <div class="permissions-grid">

            <% Object.keys(groupedPermissions).forEach(moduleName => { %>

                <div class="permission-card">

                    <h3><%= moduleName %></h3>

                    <div class="permission-list">

                        <% groupedPermissions[moduleName].forEach(permission => { %>

                            <div class="permission-item">

                                <label>

                                    <input
                                        type="checkbox"
                                        name="permissions"
                                        value="<%= permission.id %>"
                                        <%= permission.assigned ? 'checked' : '' %>>

                                    <span class="permission-name">

                                        <%= permission.permission_name %>

                                    </span>

                                </label>



                            </div>

                        <% }) %>

                    </div>

                </div>

            <% }) %>

        </div>

    </div>

</form>

<script>

    (() => {

        const form =
            document.querySelector('.permissions-form');

        if (form) {

            enableSaveOnChange(form);

        }

    })();

    //Toggle delegation-badge
    document.querySelectorAll('.delegation-badge').forEach(badge => {

    badge.addEventListener('click', () => {

        const states = ['platform', 'company', 'both'];

        let current =
            badge.dataset.scope;

        let next =
            states[(states.indexOf(current) + 1) % states.length];

        // Update data attribute
        badge.dataset.scope = next;

        // Update text
        badge.textContent =
            next.charAt(0).toUpperCase() + next.slice(1);

        // Update colour
        badge.classList.remove(
            'platform',
            'company',
            'both'
        );

        badge.classList.add(next);

        // Update hidden input
        const hidden =
            document.querySelector(
                `input[name="delegation_scope_${badge.dataset.permissionId}"]`
            );

        hidden.value = next;

        // Notify enableSaveOnChange()
        hidden.dispatchEvent(
            new Event('change', { bubbles: true })
        );

    });

});

</script>

<style>

<div class="table-container">

    <table>

        <colgroup>

            <col style="width:30%">
            <col style="width:18%">
            <col style="width:10%">
            <col style="width:8%">
            <col style="width:10%">
            <col style="width:10%">
            <col style="width:14%">

        </colgroup>

        <thead>

            <!-- Action Row -->

            <tr class="action-row">

                <th colspan="7">

                    <div class="action-row-content">

                        <span class="title">

                            Companies

                        </span>

                        <span class="toolbar-actions">

                            <input type="text" id="tableFilter" placeholder="Search companies...">

                            <% if ( permissions.includes( 'companies.create' ) ) { %>

                                <button class="btn-primary" hx-get="/settings/companies/add" hx-target="#modal"
                                    hx-swap="innerHTML">

                                    + Add

                                </button>

                                <% } %>

                        </span>

                    </div>

                </th>

            </tr>

            <!-- Header Row -->

            <tr class="header-row">

                <th class="sortable">
                    Name
                </th>

                <th class="sortable">
                    Country
                </th>

                <th class="sortable">
                    Currency
                </th>

                <th class="sortable">
                    GST
                </th>

                <th class="sortable">
                    Max Users
                </th>

                <th class="sortable">
                    Status
                </th>

                <th>
                    Action
                </th>

            </tr>

        </thead>

        <tbody>

            <% companies.forEach( company=> {
                %>

                <tr id="company-<%= company.id %>" class="<%= updatedId == company.id
                        ? 'updated-row'
                        : '' %>">

                    <td>
                        <%= company.name %>
                    </td>

                    <td>
                        <%= company.country_name || '' %>
                    </td>

                    <td>
                        <%= company.base_currency || '' %>
                    </td>

                    <td>
                        <%= company.gst_registered ? 'Yes' : 'No' %>
                    </td>

                    <td>
                        <%= company.max_users || 0 %>
                    </td>

                    <td>
                        <%= company.status %>
                    </td>

                    <td>

                        <button class="btn-secondary" hx-get="/settings/companies/<%= company.id %>/edit"
                            hx-target="#modal" hx-swap="innerHTML">

                            Edit

                        </button>

                        <button class="btn-secondary" hx-get="/settings/companies/<%= company.id %>/users"
                            hx-target="#main-content" hx-swap="innerHTML" hx-push-url="true">

                            Users

                        </button>

                    </td>

                </tr>

                <% }) %>

        </tbody>

    </table>

</div>

<script>

    initTablePage();

    enableTableFilter(
        '#tableFilter',
        'tbody tr'
    );

    enableTableSorting(
        '.table-container table'
    );

</script>

<style>
    /* ========================================= */
    /* Header Layout */
    /* ========================================= */

    .action-row-content {

        display: flex;

        justify-content: space-between;

        align-items: center;

        width: 100%;
    }

    .toolbar-actions {

        display: flex;

        align-items: center;

        gap: 10px;
    }

    .toolbar-actions input {

        width: 250px;

        padding: 8px 12px;

        border: 1px solid #cbd5e1;

        border-radius: 4px;

        font-size: 13px;
    }

    /* ========================================= */
    /* Page Title */
    /* ========================================= */

    .action-row-content .title {

        font-size: 16px;

        font-weight: 600;

        color: #1e293b;
    }

    /* ========================================= */
    /* Buttons */
    /* ========================================= */

    .btn-primary {

        background-color: #007bff;

        color: white;

        border: none;

        padding: 6px 14px;

        border-radius: 4px;

        font-size: 13px;

        font-weight: 600;

        cursor: pointer;

        transition:
            background-color 0.15s ease;
    }

    .btn-primary:hover {

        background-color: #0056b3;
    }

    .btn-secondary {

        background-color: #f8fafc;

        color: #475569;

        border: 1px solid #cbd5e1;

        padding: 6px 14px;

        border-radius: 4px;

        font-size: 13px;

        font-weight: 500;

        cursor: pointer;

        transition: all 0.15s ease;
    }

    .btn-secondary:hover {

        background-color: #e2e8f0;

        color: #0f172a;
    }

    /* ========================================= */
    /* Table */
    /* ========================================= */

    table {

        width: 100%;

        border-collapse: separate;

        border-spacing: 0;

        table-layout: fixed;

        font-family: sans-serif;
    }

    thead {

        position: sticky;

        top: 0;

        z-index: 2;
    }

    .action-row th {

        background-color: #f1f1f1;

        padding: 10px;

        text-align: left;

        border-bottom: 1px solid #ccc;
    }

    .header-row th {

        background-color: #333;

        color: white;

        padding: 12px;

        text-align: left;
    }

    td {

        padding: 12px;

        border-bottom: 1px solid #eee;

        overflow: hidden;

        text-overflow: ellipsis;

        white-space: nowrap;
    }

    tr:nth-child(even) {

        background-color: #f9f9f9;
    }

    table tbody tr {

        transition:
            background-color 0.15s ease;
    }

    table tbody tr:hover td {

        background-color:
            #b5d5f5;
    }

    /* ========================================= */
    /* Search Box */
    /* ========================================= */

    .toolbar-actions input:focus {

        outline: none;

        border-color: #007bff;

        box-shadow:
            0 0 0 3px rgba(0, 123, 255, 0.15);
    }

    .toolbar-actions input::placeholder {

        color: #94a3b8;
    }

    /* ========================================= */
    /* Sorting */
    /* ========================================= */

    .sortable {

        cursor: pointer;

        user-select: none;

        position: relative;

    }

    .sortable:hover {

        background-color: #475569;
    }

    .sortable[data-sort="asc"]::after {

        content: "▲";

        font-size: 10px;
    }

    .sortable[data-sort="desc"]::after {

        content: "▼";

        font-size: 10px;
    }


</style>
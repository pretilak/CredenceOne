<% function renderEntities() { let rows='' ; entities.forEach(entity=> {

    const disableEdit =
    !permissions.includes('entities.edit');

    const disableDelete =
    !permissions.includes('entities.delete');

    rows += `

    <tr id="entity-${entity.id}" class="${
        updatedId == entity.id
            ? 'updated-row'
            : ''
    }">
        <td>
            ${entity.name}
        </td>

        <td>
            ${entity.entity_type}
        </td>

        <td>
            ${entity.email || ''}
        </td>

        <td>
            ${entity.phone || ''}
        </td>

        <td>
            ${entity.currency_code || ''}
        </td>

        <td>
            ${entity.default_forwarder_name || ''}
        </td>

        <td>
            ${entity.is_active ? 'Yes' : 'No'}
        </td>

        <td>

            <button class="btn-secondary" hx-get="/settings/entities/${entity.id}/edit" hx-target="#modal" hx-swap="innerHTML" ${disableEdit
                ? 'disabled' : '' } title="${
                        !permissions.includes('entities.edit')
                            ? 'No permission'
                            : ''
                    }">

                Edit

            </button>

            <button class="btn-secondary" onclick="openDeleteModal(
                'entity', 
                ${entity.id}, 
                '${entity.entity_type}',
                '${entity.name.replace(/'/g, '\\\'')}'
            )" ${disableDelete ? 'disabled' : '' }
                title="${!permissions.includes('entities.delete')? 'No permission': ''}">

                Delete

            </button>

            <button class="btn-secondary" hx-get="/settings/entities/${entity.id}/contacts" hx-target="#main-content" hx-swap="innerHTML"
                hx-push-url="true">

                Contacts

            </button>
        </td>

    </tr>
    `;
    });

    return rows;

    } %>



    <div class="table-container">

        <table>

            <table>

                <colgroup>

                    <col style="width: 20%">
                    <col style="width: 8%">
                    <col style="width: 20%">
                    <col style="width: 12%">
                    <col style="width: 6%">
                    <col style="width: 14%">
                    <col style="width: 4%">
                    <col style="width: 16%">

                </colgroup>

                <thead>

                    <!-- ===================================== -->
                    <!-- Action Row -->
                    <!-- ===================================== -->

                    <tr class="action-row">

                        <th colspan="8">

                            <div class="action-row-content">

                                <span class="title">

                                    Entities

                                </span>

                                <span class="actions">

                                    <% if (permissions.includes('entities.create')) { %>

                                        <button class="btn-primary" hx-get="/settings/entities/add" hx-target="#modal"
                                            hx-swap="innerHTML">

                                            +Add

                                        </button>

                                        <% } %>

                                </span>

                            </div>

                        </th>

                    </tr>


                    <!-- ===================================== -->
                    <!-- Header Row -->
                    <!-- ===================================== -->

                    <tr class="header-row">

                        <th>Name</th>
                        <th>Type</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Currency</th>
                        <th>Forwarder</th>
                        <th>Active</th>
                        <th>Action</th>

                    </tr>

                </thead>


                <!-- ========================================= -->
                <!-- Body -->
                <!-- ========================================= -->

                <tbody>

                    <%- renderEntities() %>

                </tbody>

            </table>

    </div>



    <style>
        /* ========================================= */
        /* Header Layout */
        /* ========================================= */

        .action-row-content {

            display: flex;

            justify-content: space-between;

            align-items: center;

            width: 100%;
        }


        /* ========================================= */
        /* Page Title */
        /* ========================================= */

        .action-row-content .title {

            font-size: 16px;

            font-weight: 600;

            color: #1e293b;
        }


        /* ========================================= */
        /* Primary Button */
        /* ========================================= */

        .btn-primary {

            background-color: #007bff;

            color: #ffffff;

            border: none;

            padding: 6px 14px;

            border-radius: 4px;

            font-weight: 600;

            font-size: 13px;

            cursor: pointer;

            transition: background-color 0.15s ease-in-out;
        }

        .btn-primary:hover {

            background-color: #0056b3;
        }

        .btn-secondary {
            background-color: #f8fafc;
            color: #475569;
            border: 1px solid #cbd5e1;
            padding: 6px 14px;
            border-radius: 4px;
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.15s ease-in-out;
        }

        .btn-secondary:hover {
            background-color: #e2e8f0;
            color: #0f172a;
        }

        /* ========================================= */
        /* Table */
        /* ========================================= */

        table {

            width: 100%;

            border-collapse: separate;

            border-spacing: 0;

            font-family: sans-serif;

            table-layout: fixed;
        }

        table tbody tr {
            transition:
                background-color 0.15s ease;
        }

        table tbody tr:hover td {
            background-color:
                #b5d5f5;
        }

        /* ========================================= */
        /* Sticky Header */
        /* ========================================= */

        thead {

            position: sticky;

            top: 0;

            z-index: 2;
        }


        /* ========================================= */
        /* Action Row */
        /* ========================================= */

        .action-row th {

            background-color: #f1f1f1;

            padding: 10px;

            text-align: left;

            border-bottom: 1px solid #ccc;
        }


        /* ========================================= */
        /* Header Row */
        /* ========================================= */

        .header-row th {

            background-color: #333;

            color: white;

            padding: 12px;

            text-align: left;
        }


        /* ========================================= */
        /* Cells */
        /* ========================================= */

        td {

            padding: 12px;

            border-bottom: 1px solid #eee;

            overflow: hidden;

            text-overflow: ellipsis;

            white-space: nowrap;
        }


        /* ========================================= */
        /* Zebra */
        /* ========================================= */

        tr:nth-child(even) {

            background-color: #f9f9f9;
        }


        /* ========================================= */
        /* Name Column Wrap */
        /* ========================================= */

        td:first-child {

            white-space: normal;
        }


        /* ========================================= */
        /* Action Buttons */
        /* ========================================= */

        td:last-child {

            white-space: nowrap;
        }
    </style>

    <script>
        setTimeout(scrollToUpdatedRow, 100);
    </script>